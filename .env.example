# --- LLM (Ollama) ---
# Local: `ollama serve` + `ollama pull qwen3:8b`, auth none.
# Cloud Run: deploy/gcp/deploy.sh sets OLLAMA_HOST to the private Ollama
# service and OLLAMA_AUTH=gcp. OLLAMA_AUTH=key + OLLAMA_API_KEY = Ollama Cloud.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_AUTH=none
OLLAMA_API_KEY=
LLM_THINK=false

# --- Simulation ---
SIM_SEED=42
MAX_WORKERS=8
WORKER_IDLE_TIMEOUT_S=600
DATA_DIR=../data

# --- API ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_MAPTILER_KEY=
