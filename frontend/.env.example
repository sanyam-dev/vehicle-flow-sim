# URL of the FastAPI backend (no trailing slash). Leave empty (the default and
# the production setup): the app then calls same-origin /api, which FastAPI
# serves in production and `npm run dev` proxies locally. If no backend
# answers, the app replays the bundled demo run from /demo.
VITE_API_BASE_URL=
# Dev-only: where `npm run dev` proxies /api.
VITE_DEV_API=http://localhost:8000
